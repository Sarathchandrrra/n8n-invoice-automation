    {
      "parameters": {
        "jsCode": "// 1. Grab input JSON\nconst input = $input.first().json;\n\n// 2. Unwrap the nested \"output\" object from the Information Extractor\nconst raw = input.output || input;\n\n// 3. Normalization helpers\nconst cleanStr = (val) => (typeof val === 'string' ? val.trim() : '');\nconst cleanInvoiceNum = (val) => cleanStr(val).replace(/\\s+/g, '-').toUpperCase();\nconst cleanVendor = (val) => cleanStr(val).toLowerCase().replace(/\\b\\w/g, c => c.toUpperCase());\n\nconst parseAmount = (val) => {\n  if (typeof val === 'number') return val;\n  if (typeof val === 'string') {\n    const cleaned = val.replace(/[^0-9.-]+/g, '');\n    return parseFloat(cleaned) || null;\n  }\n  return null;\n};\n\n// 4. Read fields\nconst rawInvoiceNum = raw.invoice_number || raw.invoiceNumber || raw.invoice_no;\nconst rawVendor = raw.vendor_name || raw.vendorName || raw.vendor;\nconst rawTotal = raw.total_amount || raw.totalAmount || raw.total;\nconst rawCurrency = raw.currency || raw.currency_code;\nconst rawInvoiceDate = raw.invoice_date || raw.invoiceDate || raw.date;\nconst rawDueDate = raw.due_date || raw.dueDate;\n\n// 5. Clean & normalize\nconst invoice_number = cleanInvoiceNum(rawInvoiceNum);\nconst vendor_name = cleanVendor(rawVendor);\nconst total_amount = parseAmount(rawTotal);\nconst currency = cleanStr(rawCurrency || 'INR').toUpperCase();\nconst invoice_date = cleanStr(rawInvoiceDate);\nconst due_date = cleanStr(rawDueDate);\n\n// 6. Validation checks\nconst errors = [];\nif (!invoice_number) errors.push('Missing invoice number');\nif (!vendor_name) errors.push('Missing vendor name');\nif (!total_amount || total_amount <= 0) errors.push('Invalid or missing total amount');\nif (!invoice_date) errors.push('Missing invoice date');\n\nconst is_valid = errors.length === 0;\n\nreturn [{\n  json: {\n    vendor_name,\n    invoice_number,\n    total_amount,\n    currency,\n    invoice_date,\n    due_date,\n    gmail_message_id: $('Gmail Trigger').first().json.id,\n    is_valid,\n    errors\n  }\n}];"
      },
